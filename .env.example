# Copy to .env and fill in what you have - see server.js for exactly how
# each one is used. Nothing here is required just to run the app locally
# except JWT_SECRET and MONGODB_URI; everything else has a working
# fallback and only unlocks extra functionality once set.

# --- Required ---
JWT_SECRET=                      # any long random string - server refuses to start without this
MONGODB_URI=                     # e.g. mongodb+srv://user:pass@cluster.mongodb.net/dbname

# --- Maps (routes: GET /api/map-config) ---
# Optional. Without this, the app falls back to CARTO's free basemap tiles
# (no key needed, fine for development). Get a free key at maptiler.com,
# then restrict it to your app's domain(s) in the MapTiler dashboard.
MAPTILER_API_KEY=

# --- Paynow (EcoCash/OneMoney mobile money payments) ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# --- Bank Transfer payment method (routes/orders.js) ---
# Shown to customers as the account to pay into; an admin then confirms
# the transfer manually. Leave unset and orders will just show a
# "(not configured)" placeholder instead of failing.
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=

# --- Password reset emails ---
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# --- Misc ---
PUBLIC_URL=                      # your deployed URL, used in password-reset emails
PORT=3000
